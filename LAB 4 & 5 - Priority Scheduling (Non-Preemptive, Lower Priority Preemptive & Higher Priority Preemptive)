print ("PRIORITY NON - PREEMPTIVE")
processes = [
    ["P1", 3, 4, 2],
    ["P2", 0, 4, 0],
    ["P3", 2, 3, 1],
    ["P4", 1, 6, 1],
    ["P5", 4, 2, 3],
]

time = 0
t_wt = 0
t_tat = 0
done = []

print("P  AT   BT  PR  CT  TAT WT")

while len(done) < len(processes):

    ready = []

    for p in processes:
        if p[1] <= time and p not in done:
            ready.append(p)

    if len(ready) == 0:
        time += 1
        continue

    ready.sort(key=lambda x: x[1])
    p = ready[0]

    pid = p[0]
    at = p[1]
    bt = p[2]
    priority = p[3]

    ct = time + bt
    tat = ct - at
    wt = tat - bt

    print(pid, at, bt, priority, ct, tat, wt , sep = "\t")

    time = ct
    t_wt += wt
    t_tat += tat

    done.append(p)

print("Average WT =", t_wt / len(processes))
print("Average TAT =", t_tat / len(processes))

print ("\n")

print ("PRIORITY PREEMPTIVE")

processes = [
    ["P1", 3, 4, 2],
    ["P2", 0, 4, 0],
    ["P3", 2, 3, 1],
    ["P4", 1, 6, 1],
    ["P5", 4, 2, 3],
]

time = 0
done = []
remain = {p[0]: p[2] for p in processes}

E = 0
G = 0

print("PID AT  BT  PR  CT  TAT WT")

while len(done) < len(processes):

    ready = []

    for p in processes:
        if p[1] <= time and p not in done:
            ready.append(p)

    if len(ready) == 0:
        time += 1
        continue


    ready.sort(key=lambda p:p[3])
    p = ready[0]

    remain[p[0]] -= 1
    time += 1

    if remain[p[0]] == 0:

        pid = p[0]
        at = p[1]
        bt = p[2]
        pr = p[3]

        ct = time
        tat = ct - at
        wt = tat - bt

        print(pid, at, bt, pr, ct, tat, wt, sep="\t")

        E += wt
        G += tat
        done.append(p)

priority_avgwt = E / 5
priority_avgtat = G / 5

print("\nAvg WT =", priority_avgwt)
print("Avg TAT =", priority_avgtat)

